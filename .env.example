# Django Settings
DEBUG=False
SECRET_KEY=your-super-secret-key-change-this-in-production-at-least-50-chars
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com,www.your-domain.com

# Database Configuration (PostgreSQL)
DB_NAME=suarez_db
DB_USER=suarez_user
DB_PASSWORD=your-secure-database-password-change-this-to-something-strong

# Email Configuration (Gmail example)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True

# Redis Configuration (para caché y sesiones)
REDIS_URL=redis://redis:6379/0

